@page
@model ContactFormApp.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Form";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4 text-center">ContactForm</h2>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                @Model.SuccessMessage
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="ContactMessage.Name" class="form-label"></label>
                <input asp-for="ContactMessage.Name" class="form-control" />
                <span asp-validation-for="ContactMessage.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactMessage.Email" class="form-label"></label>
                <input asp-for="ContactMessage.Email" class="form-control" />
                <span asp-validation-for="ContactMessage.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactMessage.Message" class="form-label"></label>
                <textarea asp-for="ContactMessage.Message" class="form-control" rows="5"></textarea>
                <span asp-validation-for="ContactMessage.Message" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Send Message</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
